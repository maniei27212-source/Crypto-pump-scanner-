REQUEST_TIMEOUT = 12

MIN_LIQUIDITY = 75_000
MIN_VOLUME_5M = 5_000
MIN_VOLUME_1H = 20_000

MAX_TOKENS = 100
MAX_PAIRS = 120
MAX_CANDIDATES_FOR_OHLCV = 20

